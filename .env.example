# ---------- Telegram ----------
# Create a bot with @BotFather, paste the token here.
# Leave TELEGRAM_BOT_TOKEN empty to run without a bot: the API then exposes
# /api/dev/telegram/* so the whole flow can be driven locally (dev only).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ZinapoBot
# Public HTTPS URL of the webhook. Empty in local dev → long polling is used.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=change-me-32-random-chars-minimum

# ---------- Secrets ----------
OTP_HMAC_SECRET=change-me-32-random-bytes
JWT_ACCESS_SECRET=change-me-32-random-bytes

# ---------- PINFL (INV-06) ----------
# Two independent keys. PINFL_HASH_SALT keys the lookup hash; PINFL_ENC_KEY
# decrypts the stored PINFL for admission-list matching. Keep them apart from
# the database credentials — in production both belong in a KMS.
# Rotating PINFL_HASH_SALT invalidates every stored pinfl_hash: duplicate
# detection stops working until the column is re-derived.
PINFL_HASH_SALT=change-me-32-random-bytes-min
PINFL_ENC_KEY=change-me-32-random-bytes-min

# ---------- Infrastructure ----------
POSTGRES_USER=zinapo
POSTGRES_PASSWORD=zinapo
POSTGRES_DB=zinapo
DATABASE_URL=postgres://zinapo:zinapo@db:5432/zinapo
REDIS_URL=redis://redis:6379

# ---------- App ----------
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
# Cookies are Secure in production; must be false over plain http in dev.
COOKIE_SECURE=false

# Host ports for the dockerised db/redis (container side stays 5432/6379).
DB_HOST_PORT=15432
REDIS_HOST_PORT=16379
